{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "// ── Git (safe operations) ──",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git shortlog:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git blame:*)",
      "Bash(git worktree:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "// ── GitHub CLI (read-only) ──",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh api:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh search:*)",
      "Bash(gh auth status:*)",
      "// ── Node.js / Frontend ──",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(tsx:*)",
      "Bash(ts-node:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Bash(eslint:*)",
      "Bash(biome:*)",
      "Bash(tsc:*)",
      "Bash(prettier:*)",
      "// ── Python ──",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(pytest:*)",
      "Bash(flake8:*)",
      "Bash(black:*)",
      "Bash(isort:*)",
      "// ── Other languages / build tools ──",
      "Bash(make:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "// ── Shell utilities ──",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(ln:*)",
      "Bash(chmod:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(zip:*)",
      "Bash(xargs:*)",
      "Bash(date:*)",
      "Bash(env:*)",
      "Bash(whoami:*)",
      "Bash(hostname:*)",
      "Bash(pwd:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(rm:*)",
      "Bash(source:*)",
      "Bash(nvm:*)",
      "Bash(export:*)",
      "// ── AWS (read-only / non-prod) ──",
      "Bash(aws sts:*)",
      "Bash(aws iam list:*)",
      "Bash(aws iam get:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws s3api get:*)",
      "Bash(aws s3api list:*)",
      "Bash(aws s3api head:*)",
      "Bash(aws logs:*)",
      "Bash(aws cloudwatch get:*)",
      "Bash(aws cloudwatch list:*)",
      "Bash(aws cloudwatch describe:*)",
      "Bash(aws cloudfront get:*)",
      "Bash(aws cloudfront list:*)",
      "Bash(aws ec2 describe:*)",
      "Bash(aws ecs describe:*)",
      "Bash(aws ecs list:*)",
      "Bash(aws lambda get:*)",
      "Bash(aws lambda list:*)",
      "Bash(aws ssm get:*)",
      "Bash(aws secretsmanager get:*)",
      "Bash(aws secretsmanager list:*)",
      "Bash(aws secretsmanager describe:*)",
      "Bash(aws rds describe:*)",
      "Bash(aws dynamodb describe:*)",
      "Bash(aws dynamodb list:*)",
      "Bash(aws sqs get:*)",
      "Bash(aws sqs list:*)",
      "Bash(aws sns list:*)",
      "Bash(aws sns get:*)",
      "Bash(aws configure list:*)",
      "Bash(AWS_PROFILE=bi-prod aws s3:*)",
      "// ── Web ──",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "// ── Secrets ──",
      "Read(./.env)",
      "Read(./.env.*)",
      "// ── Noise ──",
      "Read(**/node_modules/**)",
      "Read(node_modules/**)"
    ]
  },
  "model": "sonnet[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-typecheck.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/commands/statusline-command.sh"
  },
  "enabledPlugins": {
    "finish-up@embarkvet-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "embarkvet-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "embarkvetlabs/embarkvet-claude-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high"
}
